# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Provider selection (modular — swap by changing these, no code changes)
# ---------------------------------------------------------------------------
# Embedder: "local" (sentence-transformers) | "openai" | "voyage"
EMBEDDER_PROVIDER=local
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5

# LLM: "ollama" (default) | "openai" | "anthropic"
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:1b
LLM_BASE_URL=http://localhost:11434

# NLI (hallucination detection) model
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=support_kb

# ---------------------------------------------------------------------------
# Retrieval / generation knobs
# ---------------------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
MMR_LAMBDA=0.5
HALLUCINATION_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Optional API keys (only used if the matching provider is selected)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
